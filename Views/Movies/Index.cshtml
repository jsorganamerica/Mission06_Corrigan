@model List<Mission06_Corrigan.Models.Movie>

@{
    ViewData["Title"] = "Movie Collection";
}

<h1 class="mb-3">Joel Hilton Movie Collection</h1>

<table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-dark">
    <tr>
        <th>Title</th>
        <th>Year</th>
        <th>Edited</th>
        <th>Copied To Plex</th>
        <th style="width: 180px;">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Title</td>
            <td>@m.Year</td>
            <td>@(m.Edited ? "Yes" : "No")</td>
            <td>@(m.CopiedToPlex ? "Yes" : "No")</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@m.MovieId">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@m.MovieId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>