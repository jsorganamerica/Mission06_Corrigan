@model Mission06_Corrigan.Models.Movie

@{
    ViewData["Title"] = "Add Movie";
}

<h2>Add Movie</h2>

<form method="post">

    <div>
        <label asp-for="Category"></label>
        <input asp-for="Category" />
        <span asp-validation-for="Category"></span>
    </div>

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label asp-for="Year"></label>
        <input asp-for="Year" />
        <span asp-validation-for="Year"></span>
    </div>

    <div>
        <label asp-for="Director"></label>
        <input asp-for="Director" />
        <span asp-validation-for="Director"></span>
    </div>

    <div>
        <label asp-for="Rating"></label>
        <select asp-for="Rating">
            <option value="">Select</option>
            <option>G</option>
            <option>PG</option>
            <option>PG-13</option>
            <option>R</option>
        </select>
        <span asp-validation-for="Rating"></span>
    </div>

    <div>
        <label>Edited</label>
        <select asp-for="Edited">
            <option value="">Select</option>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <div>
        <label asp-for="LentTo"></label>
        <input asp-for="LentTo" />
    </div>

    <div>
        <label asp-for="Notes"></label>
        <input asp-for="Notes" />
        <span asp-validation-for="Notes"></span>
        <small>(Max 25 characters)</small>
    </div>

    <button type="submit">Add Movie</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}